<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EventPlanner-cli\EventPlanner-cli.csproj">
      <Properties>
	CustomConsole=..\MockSpectre\MockSpectre.csproj;
	StorageService=..\MockStorageService\MockStorageService.csproj;
      </Properties>
    </ProjectReference>
    <ProjectReference Include="..\MockStorageService\MockStorageService.csproj" />
    <ProjectReference Include="..\MockSpectre\MockSpectre.csproj" />
  </ItemGroup>

</Project>